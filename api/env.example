# Flask Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Security
SECRET_KEY=dev-secret-key-change-in-production

# API Configuration
API_PORT=5000

# CORS Configuration
# Comma-separated list of allowed origins (use * for all origins)
CORS_ORIGINS=*

# Database Configuration - PostgreSQL
# Database connection URL (overrides individual settings if provided)
# DATABASE_URL=postgresql://user:password@localhost:5432/job_match

# Individual database settings (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_match
DB_USER=postgres
DB_PASSWORD=postgres

# SQLAlchemy Configuration
# Set to True to log all SQL queries (useful for debugging)
SQLALCHEMY_ECHO=False

# Ollama Configuration
# Base URL for Ollama API
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name to use
OLLAMA_MODEL=llama2

# Ollama request timeout in seconds
OLLAMA_TIMEOUT=30

# Gemini Configuration
# Google API key for Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name to use
GEMINI_MODEL=gemini-pro

# Gemini request timeout in seconds
GEMINI_TIMEOUT=30

# Prompt Configuration
# Path to the job vacancy analysis prompt file
PROMPT_JOB_ANALYS=./prompts/job_vacancy_analysis.txt

# Hugging Face Hub Configuration (used by docling)
# Disable symlinks warning on Windows
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Optional: Enable Xet Storage for better performance (requires: pip install hf_xet)
# HF_HUB_ENABLE_XET=1

